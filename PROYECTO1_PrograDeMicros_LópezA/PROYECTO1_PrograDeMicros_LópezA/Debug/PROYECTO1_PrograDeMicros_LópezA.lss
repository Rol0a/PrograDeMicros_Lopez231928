                                 #pragma AVRPART MEMORY INT_SRAM SIZE 2048
                                 #pragma AVRPART MEMORY INT_SRAM START_ADDR 0x100
                                 
                                 
                                 
                                 ; ***** BOOTLOADER DECLARATIONS ******************************************
                                 .equ	NRWW_START_ADDR	= 0x3800
                                 .equ	NRWW_STOP_ADDR	= 0x3fff
                                 .equ	RWW_START_ADDR	= 0x0
                                 .equ	RWW_STOP_ADDR	= 0x37ff
                                 .equ	PAGESIZE	= 64
                                 .equ	FIRSTBOOTSTART	= 0x3f00
                                 .equ	SECONDBOOTSTART	= 0x3e00
                                 .equ	THIRDBOOTSTART	= 0x3c00
                                 .equ	FOURTHBOOTSTART	= 0x3800
                                 .equ	SMALLBOOTSTART	= FIRSTBOOTSTART
                                 .equ	LARGEBOOTSTART	= FOURTHBOOTSTART
                                 
                                 
                                 
                                 ; ***** INTERRUPT VECTORS ************************************************
                                 .equ	INT0addr	= 0x0002	; External Interrupt Request 0
                                 .equ	INT1addr	= 0x0004	; External Interrupt Request 1
                                 .equ	PCI0addr	= 0x0006	; Pin Change Interrupt Request 0
                                 .equ	PCI1addr	= 0x0008	; Pin Change Interrupt Request 0
                                 .equ	PCI2addr	= 0x000a	; Pin Change Interrupt Request 1
                                 .equ	WDTaddr	= 0x000c	; Watchdog Time-out Interrupt
                                 .equ	OC2Aaddr	= 0x000e	; Timer/Counter2 Compare Match A
                                 .equ	OC2Baddr	= 0x0010	; Timer/Counter2 Compare Match A
                                 .equ	OVF2addr	= 0x0012	; Timer/Counter2 Overflow
                                 .equ	ICP1addr	= 0x0014	; Timer/Counter1 Capture Event
                                 .equ	OC1Aaddr	= 0x0016	; Timer/Counter1 Compare Match A
                                 .equ	OC1Baddr	= 0x0018	; Timer/Counter1 Compare Match B
                                 .equ	OVF1addr	= 0x001a	; Timer/Counter1 Overflow
                                 .equ	OC0Aaddr	= 0x001c	; TimerCounter0 Compare Match A
                                 .equ	OC0Baddr	= 0x001e	; TimerCounter0 Compare Match B
                                 .equ	OVF0addr	= 0x0020	; Timer/Couner0 Overflow
                                 .equ	SPIaddr	= 0x0022	; SPI Serial Transfer Complete
                                 .equ	URXCaddr	= 0x0024	; USART Rx Complete
                                 .equ	UDREaddr	= 0x0026	; USART, Data Register Empty
                                 .equ	UTXCaddr	= 0x0028	; USART Tx Complete
                                 .equ	ADCCaddr	= 0x002a	; ADC Conversion Complete
                                 .equ	ERDYaddr	= 0x002c	; EEPROM Ready
                                 .equ	ACIaddr	= 0x002e	; Analog Comparator
                                 .equ	TWIaddr	= 0x0030	; Two-wire Serial Interface
                                 .equ	SPMRaddr	= 0x0032	; Store Program Memory Read
                                 
                                 .equ	INT_VECTORS_SIZE	= 52	; size in words
                                 
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 * PROYECTO
                                 * Creado: Rodrigo López [231928]
                                 * Autor : Marcos Rodrigo López Agustín [231928]
                                 * Descripción: Reloj 24h / Fecha / Alarma
                                 =========================================================*/
                                 
                                 .include "M328PDEF.inc"
                                 
                                 ;***** Created: 2011-02-09 12:03 ******* Source: ATmega328P.xml **********
                                 ;*************************************************************************
                                 ;* A P P L I C A T I O N   N O T E   F O R   T H E   A V R   F A M I L Y
                                 ;* 
                                 ;* Number            : AVR000
                                 ;* File Name         : "m328Pdef.inc"
                                 ;* Title             : Register/Bit Definitions for the ATmega328P
                                 ;* Date              : 2011-02-09
                                 ;* Version           : 2.35
                                 ;* Support E-mail    : avr@atmel.com
                                 ;* Target MCU        : ATmega328P
                                 ;* 
                                 ;* DESCRIPTION
                                 ;* When including this file in the assembly program file, all I/O register 
                                 ;* names and I/O register bit names appearing in the data book can be used.
                                 ;* In addition, the six registers forming the three data pointers X, Y and 
                                 ;* Z have been assigned names XL - ZH. Highest RAM address for Internal 
                                 ;* SRAM is also defined 
                                 ;* 
                                 ;* The Register names are represented by their hexadecimal address.
                                 ;* 
                                 ;* The Register Bit names are represented by their bit number (0-7).
                                 ;* 
                                 ;* Please observe the difference in using the bit names with instructions
                                 ;* such as "sbr"/"cbr" (set/clear bit in register) and "sbrs"/"sbrc"
                                 ;* (skip if bit in register set/cleared). The following example illustrates
                                 ;* this:
                                 ;* 
                                 ;* in    r16,PORTB             ;read PORTB latch
                                 ;* sbr   r16,(1<<PB6)+(1<<PB5) ;set PB6 and PB5 (use masks, not bit#)
                                 ;* out   PORTB,r16             ;output to PORTB
                                 ;* 
                                 ;* in    r16,TIFR              ;read the Timer Interrupt Flag Register
                                 ;* sbrc  r16,TOV0              ;test the overflow flag (use bit#)
                                 ;* rjmp  TOV0_is_set           ;jump if set
                                 ;* ...                         ;otherwise do something else
                                 ;*************************************************************************
                                 
                                 #ifndef _M328PDEF_INC_
                                 #endif  /* _M328PDEF_INC_ */
                                 
                                 ; ***** END OF FILE ******************************************************
                                 
                                 /*=========================================================
                                 =                    DATA SECTION (SRAM)                 =*/
                                 .dseg
                                 .org SRAM_START
                                 
                                 // -------- DISPLAY DIGITS --------
000100                           DISPLAY_01:     .BYTE 1
000101                           DISPLAY_02:     .BYTE 1
000102                           DISPLAY_03:     .BYTE 1
000103                           DISPLAY_04:     .BYTE 1
                                 
                                 // -------- CLOCK STORAGE --------
000104                           COUNT_SEC:      .BYTE 1      // 0–59
000105                           COUNT_MIN:      .BYTE 1      // 0–59
000106                           COUNT_HOUR:     .BYTE 1      // 0–23
                                 
                                 // -------- DATE STORAGE --------
000107                           DAY:            .BYTE 1      // 1–31
000108                           MONTH:          .BYTE 1      // 1–12
                                 
                                 // -------- ALARM STORAGE --------
000109                           ALARM_MIN:      .BYTE 1
00010a                           ALARM_HOUR:     .BYTE 1
                                 
                                 // -------- SYSTEM CONTROL --------
00010b                           MUX_SEL:        .BYTE 1
00010c                           TICKS_10MS:     .BYTE 1
                                 
00010d                           FLAG_UP:        .BYTE 1
00010e                           FLAG_DOWN:      .BYTE 1
00010f                           FLAG_MODE:      .BYTE 1
000110                           FLAG_CONFIRM:   .BYTE 1
000111                           FLAG_MINUTE:	.BYTE 1
                                 
000112                           BLINK_FLAG:     .BYTE 1
000113                           BLINK_COUNT:    .BYTE 1
                                 
000114                           ALARM_ACTIVE:   .BYTE 1
000115                           PREV_PINC: .BYTE 1
                                 
000116                           HALFSEC_CNT: .BYTE 1 
000117                           SEC_CNT:     .BYTE 1   
                                 
                                 
                                 /*=========================================================
                                 =              REGISTER DEFINITIONS                      =*/
                                 .def MODE     = R20      // 0=CLOCK,1=CLOCK_EDIT,2=DATE,3=DATE_EDIT,4=ALARM,5=ALARM_EDIT
                                 .def ACTION   = R21      // Selected digit in edit mode
                                 .def DECREASE = R22
                                 .def INCREASE = R23
                                 
                                 
                                 /*=========================================================
                                 =                INTERRUPT VECTORS                       =*/
                                 .cseg
                                 .org 0x0000
000000 c01f                      RJMP INIT
                                 
                                 .org 0x0008
000008 c1d0                      RJMP PCINT_ISR
                                 
                                 .org 0x001C
00001c c16c                      RJMP TIMER0_ISR
                                 
                                 .org 0x0016
000016 c186                      RJMP TIMER1_ISR
                                 
                                 .org 0x0020
                                 /*=========================================================
                                 =                   STACK INITIALIZATION                 = */
                                 INIT:
000020 ef0f                          LDI R16, LOW(RAMEND)
000021 bf0d                          OUT SPL, R16
000022 e008                          LDI R16, HIGH(RAMEND)
000023 bf0e                          OUT SPH, R16
000024 c000                          RJMP CONFIG
                                 
                                 /*=========================================================
                                 =                   GENERAL CONFIGURATION                = */
                                 CONFIG:
                                 
                                 // ---- Clock prescaler → 1 MHz ----
000025 e800                      	LDI R16, (1 << CLKPCE)
000026 9300 0061                 	STS CLKPR, R16
000028 e004                      	LDI R16, 0b00000100
000029 9300 0061                 	STS CLKPR, R16
                                 
                                 // ---- Disable USART ----
00002b e000                          LDI R16, 0x00
00002c 9300 00c1                     STS UCSR0B, R16
                                 
                                 
                                 /*=========================================================
                                 =                   PORT CONFIGURATION                   =*/
                                 
                                 // ---- Multiplex transistors and Mode Representations (PORTB) ----
00002e e70f                          LDI R16, 0x7F // 00111111, PB0-3 son salidas para transistores, PB4 es salida para alarma y PB5 salida para un LED de modo.
00002f b904                          OUT DDRB, R16
000030 e001                          LDI R16, 0b00000001
000031 b905                          OUT PORTB, R16
                                 
                                 // ---- 7-Segment segments (PORTD) ----
000032 ef0f                          LDI R16, 0xFF
000033 b90a                          OUT DDRD, R16
000034 b90b                          OUT PORTD, R16
                                 
                                 // ---- Buttons (PORTC) ----
000035 e300                          LDI R16, 0x30 // 0b00110000, PORTC4 y PORTC5 son Salidas
000036 b907                          OUT DDRC, R16
000037 e00f                          LDI R16, 0x0F // 0b00011111, Se indica que las entradas son Pull Ups y que se inicia con el MODO 1 activado
000038 b908                          OUT PORTC, R16
                                 
                                 	// NOTA: PC4 es el LED Amarillo (Modo Reloj), PC5 es el LED Verde (Modo Alarma), PB5 es el LED Azul (Modo Fecha)
                                 /*=========================================================
                                 =                 PIN CHANGE INTERRUPT                   =*/
000039 e002                          LDI R16, (1 << PCIE1)
00003a 9300 0068                     STS PCICR, R16
00003c e00f                          LDI R16, (1 << PCINT8)|(1 << PCINT9)|(1 << PCINT10)|(1 << PCINT11)
00003d 9300 006c                     STS PCMSK1, R16
                                 
                                 /*=========================================================
                                 =                 TIMER0 CONFIGURATION                   =*/
00003f d1be                          RCALL TIMER0_SETUP
000040 d1c9                      	RCALL TIMER1_SETUP
                                 /*=========================================================
                                 =                 VARIABLE INITIALIZATION                =*/
000041 e042                          LDI MODE, 0x02
000042 2755                          CLR ACTION
000043 2700                          CLR R16
                                 
000044 9300 0100                     STS DISPLAY_01, R16
000046 9300 0101                     STS DISPLAY_02, R16
000048 9300 0102                     STS DISPLAY_03, R16
00004a 9300 0103                     STS DISPLAY_04, R16
                                 /* QUE INICIE EN CERO
                                     STS COUNT_SEC, R16
                                     STS COUNT_MIN, R16
                                     STS COUNT_HOUR, R16
                                 	*/
                                 // ----HACER QUE EL CLOCK INICIE CON UN VALOR ----
00004c e30a                      	LDI R16, 58
00004d 9300 0105                 	STS COUNT_MIN, R16
                                 
00004f e107                      	LDI R16, 23
000050 9300 0106                 	STS COUNT_HOUR, R16
                                 
000052 2700                      	CLR R16
000053 9300 0104                 	STS COUNT_SEC, R16
                                 
                                   //STS DAY, R16
                                  // STS MONTH, R16
                                 
                                 /* QUE INICIE EN UNA FECHA ESPECIFICA */
000055 e104                      	LDI R16, 20
000056 9300 0107                 	STS DAY, R16
                                 
000058 e006                      	LDI R16, 6
000059 9300 0108                 	STS MONTH, R16 
                                 
                                 // ----HACER QUE EL RELOJ INICIE CON UN VALOR -----
                                  /*STS ALARM_MIN, R16
                                     STS ALARM_HOUR, R16 */
00005b e000                      	LDI R16, 0
00005c 9300 0109                 	STS ALARM_MIN, R16
                                 
00005e e000                      	LDI R16, 0
00005f 9300 010a                 	STS ALARM_HOUR, R16
                                 
000061 9300 010b                     STS MUX_SEL, R16
000063 9300 010c                     STS TICKS_10MS, R16
000065 9300 010d                     STS FLAG_UP, R16
000067 9300 010e                     STS FLAG_DOWN, R16
000069 9300 010f                     STS FLAG_MODE, R16
00006b 9300 0110                     STS FLAG_CONFIRM, R16
00006d 9300 0112                     STS BLINK_FLAG, R16
00006f 9300 0113                     STS BLINK_COUNT, R16
000071 9300 0114                     STS ALARM_ACTIVE, R16
                                 
000073 b106                      	IN   R16, PINC
000074 9300 0115                     STS  PREV_PINC, R16
000076 9478                          SEI
                                 
                                 
                                 /*=========================================================
                                 =                      MAIN LOOP                         =*/
                                 MAIN_LOOP:
                                 
                                 // ORDEN DE FUNCIONES QUE TIENE EL CODIGO
000077 d09b                          RCALL MODE_MANAGER
000078 d0c1                          RCALL EDIT_ENGINE
000079 d0ca                          RCALL ALARM_MANAGER
                                 
                                 // LLAMADO DE LOGICA DE MULTIPLEX
00007a d007                          RCALL DISPLAY_MANAGER     // Llamado a los valores dentro de los displays
00007b d060                          RCALL MUX_HANDLER         // Llamado al multiplexado correcto
                                 
00007c 9110 010f                 	LDS R17, FLAG_MODE
00007e 3011                      	CPI R17, 1
00007f f409                      	BRNE NO_TEST
                                 
000080 982d                      	CBI PORTB, PB5   // LED ON
                                 
                                 NO_TEST:
000081 cff5                          RJMP MAIN_LOOP
                                 
                                 //			   NON-INTERRUPT ROUTINES                     //
                                 /*=========================================================
                                 =                DISPLAY MANAGER                         =*/
                                 DISPLAY_MANAGER:
000082 930f                      	PUSH R16
                                 
000083 2f04                          MOV R16, MODE
                                 
                                 // -------- CLOCK --------
000084 3000                          CPI R16, 0
000085 f059                          BREQ LOAD_CLOCK
                                 
000086 3001                          CPI R16, 1
000087 f049                          BREQ LOAD_CLOCK
                                 
                                 // -------- DATE --------
000088 3002                          CPI R16, 2
000089 f0b1                          BREQ LOAD_DATE
                                 
00008a 3003                          CPI R16, 3
00008b f0a1                          BREQ LOAD_DATE
                                 
                                 // -------- ALARM --------
00008c 3004                          CPI R16, 4
00008d f109                          BREQ LOAD_ALARM
                                 
00008e 3005                          CPI R16, 5
00008f f0f9                          BREQ LOAD_ALARM
                                 
000090 c049                          RJMP DISPLAY_EXIT
                                 
                                 // =========================
                                 LOAD_CLOCK:
                                     // Example split HH:MM
000091 9100 0106                     LDS R16, COUNT_HOUR
000093 d073                          RCALL SPLIT_DIGITS_2
000094 9310 0100                     STS DISPLAY_01, R17
000096 9320 0101                     STS DISPLAY_02, R18
                                 
000098 9100 0105                     LDS R16, COUNT_MIN
00009a d06c                          RCALL SPLIT_DIGITS_2
00009b 9310 0102                     STS DISPLAY_03, R17
00009d 9320 0103                     STS DISPLAY_04, R18
00009f c01d                          RJMP APPLY_BLINK
                                 
                                 // =========================
                                 LOAD_DATE:
0000a0 9100 0107                     LDS R16, DAY
0000a2 d064                          RCALL SPLIT_DIGITS_2
0000a3 9310 0100                     STS DISPLAY_01, R17
0000a5 9320 0101                     STS DISPLAY_02, R18
                                 
0000a7 9100 0108                     LDS R16, MONTH
0000a9 d05d                          RCALL SPLIT_DIGITS_2
0000aa 9310 0102                     STS DISPLAY_03, R17
0000ac 9320 0103                     STS DISPLAY_04, R18
0000ae c00e                          RJMP APPLY_BLINK
                                 
                                 // =========================
                                 LOAD_ALARM:
0000af 9100 010a                     LDS R16, ALARM_HOUR
0000b1 d055                          RCALL SPLIT_DIGITS_2
0000b2 9310 0100                     STS DISPLAY_01, R17
0000b4 9320 0101                     STS DISPLAY_02, R18
                                 
0000b6 9100 0109                     LDS R16, ALARM_MIN
0000b8 d04e                          RCALL SPLIT_DIGITS_2
0000b9 9310 0102                     STS DISPLAY_03, R17
0000bb 9320 0103                     STS DISPLAY_04, R18
                                 
                                 // =========================
                                 APPLY_BLINK:
                                 
                                 // Only in edit modes (odd modes)
0000bd 2f04                          MOV R16, MODE
0000be 7001                          ANDI R16, 0x01
0000bf f0d1                          BREQ DISPLAY_EXIT
                                 
0000c0 9100 0112                     LDS R16, BLINK_FLAG
0000c2 3000                          CPI R16, 0
0000c3 f4b1                          BRNE DISPLAY_EXIT
                                 
                                 // Turn OFF selected digit
0000c4 2f05                          MOV R16, ACTION
0000c5 3000                          CPI R16, 0
0000c6 f039                          BREQ BLANK_D0
0000c7 3001                          CPI R16, 1
0000c8 f049                          BREQ BLANK_D1
0000c9 3002                          CPI R16, 2
0000ca f051                          BREQ BLANK_D2
0000cb 3003                          CPI R16, 3
0000cc f059                          BREQ BLANK_D3
0000cd c00c                          RJMP DISPLAY_EXIT
                                 
0000ce 2700                      BLANK_D0: CLR R16 // blank = 0
0000cf 9300 0100                     STS DISPLAY_01, R16
0000d1 c008                          RJMP DISPLAY_EXIT
                                 
                                 BLANK_D1:
0000d2 9300 0101                     STS DISPLAY_02, R16
0000d4 c005                          RJMP DISPLAY_EXIT
                                 
                                 BLANK_D2:
0000d5 9300 0102                     STS DISPLAY_03, R16
0000d7 c002                          RJMP DISPLAY_EXIT
                                 
                                 BLANK_D3:
0000d8 9300 0103                     STS DISPLAY_04, R16
                                 
                                 DISPLAY_EXIT:
0000da 910f                          POP R16
0000db 9508                          RET
                                 MUX_HANDLER:
                                 
0000dc 930f                          PUSH R16
                                 
                                 // ---- Turn OFF all digits ----
0000dd 9828                      	CBI PORTB, PB0
0000de 9829                      	CBI PORTB, PB1
0000df 982a                      	CBI PORTB, PB2
0000e0 982b                      	CBI PORTB, PB3
                                 
                                 // ---- Select active digit ----
0000e1 9100 010b                     LDS R16, MUX_SEL
                                 
0000e3 3000                          CPI R16, 0
0000e4 f041                          BREQ MUX_D0
                                 
0000e5 3001                          CPI R16, 1
0000e6 f051                          BREQ MUX_D1
                                 
0000e7 3002                          CPI R16, 2
0000e8 f061                          BREQ MUX_D2
                                 
                                 // ---- Default → D3 ----
                                 MUX_D3:
0000e9 9a2b                          SBI PORTB, PB3
0000ea 9100 0103                     LDS R16, DISPLAY_04
0000ec c00b                          RJMP LOAD_SEGMENTS
                                 
                                 MUX_D0:
0000ed 9a28                          SBI PORTB, PB0
0000ee 9100 0100                     LDS R16, DISPLAY_01
0000f0 c007                          RJMP LOAD_SEGMENTS
                                 
                                 MUX_D1:
0000f1 9a29                          SBI PORTB, PB1
0000f2 9100 0101                     LDS R16, DISPLAY_02
0000f4 c003                          RJMP LOAD_SEGMENTS
                                 
                                 MUX_D2:
0000f5 9a2a                          SBI PORTB, PB2
0000f6 9100 0102                     LDS R16, DISPLAY_03
                                 
                                 LOAD_SEGMENTS:
0000f8 d002                          RCALL SEGMENT_LOOKUP
                                 
0000f9 910f                          POP R16
0000fa 9508                          RET
                                 
                                 SEGMENT_LOOKUP:
                                 
0000fb 93ef                          PUSH ZL
0000fc 93ff                          PUSH ZH
                                 
0000fd e0f4                          LDI ZH, HIGH(SEG_TAB<<1)
0000fe e3e8                          LDI ZL, LOW(SEG_TAB<<1)
                                 
0000ff 0fe0                          ADD ZL, R16
000100 f408                          BRCC NO_CARRY
000101 95f3                          INC ZH
                                 NO_CARRY:
                                 
000102 9104                          LPM R16, Z
000103 b90b                          OUT PORTD, R16
                                 
000104 91ff                          POP ZH
000105 91ef                          POP ZL
000106 9508                          RET
                                 
                                 SPLIT_DIGITS_2:
                                 
000107 930f                          PUSH R16
000108 933f                          PUSH R19
                                 
000109 2711                          CLR R17
                                 
                                 DIV10_LOOP:
00010a 300a                          CPI R16, 10
00010b f018                          BRLO DONE_DIV
00010c 500a                          SUBI R16, 10
00010d 9513                          INC R17
00010e cffb                          RJMP DIV10_LOOP
                                 
                                 DONE_DIV:
00010f 2f20                          MOV R18, R16
                                 
000110 913f                          POP R19
000111 910f                          POP R16
000112 9508                          RET
                                 /*=========================================================
                                 =                MODE MANAGER (FSM)                      =*/
                                 MODE_MANAGER: // Checkeo de si la bandera fue activada o no
000113 9100 010f                     LDS R16, FLAG_MODE
000115 3001                          CPI R16, 1
000116 f449                          BRNE EXIT_MODE
                                 
000117 2700                          CLR R16
000118 9300 010f                     STS FLAG_MODE, R16
                                 
00011a 9543                          INC MODE
00011b 3046                          CPI MODE, 6
00011c f008                          BRLO OK
00011d 2744                          CLR MODE
                                 
                                 OK:
00011e 2755                          CLR ACTION
00011f d001                          RCALL UPDATE_MODE_LEDS
                                 
                                 EXIT_MODE:
000120 9508                          RET
                                 	// CAMBIAR DE LED QUE SE ESTA USANDO 
                                 UPDATE_MODE_LEDS:
                                 
000121 930f                          PUSH R16
000122 931f                          PUSH R17
                                 
000123 b108                          IN   R16, PORTC
000124 7c0f                          ANDI R16, 0b11001111     // LIMPIAR REGISTROS
000125 b908                          OUT  PORTC, R16
                                 
000126 982d                          CBI PORTB, PB5           // LIMPIAR REGISTROS
                                 
                                 // Revisar modos de display
000127 2f04                          MOV  R16, MODE
000128 7001                          ANDI R16, 0x01           
000129 f021                          BREQ SET_BASE_LED        
                                 
                                 // Revisar modos de parpadeo
00012a 9100 0112                     LDS  R16, BLINK_FLAG
00012c 3000                          CPI  R16, 0
00012d f049                          BREQ EXIT_UPDATE         
                                 
                                 // Modos de Display 
                                 SET_BASE_LED:
                                 
00012e 3042                          CPI MODE, 2
00012f f030                          BRLO MODE_CLOCK
                                 
000130 3044                          CPI MODE, 4
000131 f010                          BRLO MODE_DATE
                                 
                                 // Confirmacion de Displays de Modos
                                 MODE_ALARM:
000132 9a45                          SBI PORTC, PC5
000133 c003                          RJMP EXIT_UPDATE
                                 
                                 MODE_DATE:
000134 9a2d                          SBI PORTB, PB5
000135 c001                          RJMP EXIT_UPDATE
                                 
                                 MODE_CLOCK:
000136 9a44                          SBI PORTC, PC4
                                 
                                 EXIT_UPDATE:
000137 911f                          POP R17
000138 910f                          POP R16
000139 9508                          RET
                                 /*=========================================================
                                 =                EDIT ENGINE                             =*/
                                 EDIT_ENGINE:
                                 
00013a 2f04                          MOV R16, MODE
00013b 3001                          CPI R16, 1
00013c f029                          BREQ DO_EDIT
                                 
00013d 3003                          CPI R16, 3
00013e f019                          BREQ DO_EDIT
                                 
00013f 3005                          CPI R16, 5
000140 f009                          BREQ DO_EDIT
                                 
000141 9508                          RET
                                 
                                 DO_EDIT:
                                 // If FLAG_UP:
                                 //   Increment selected value
                                 //   Validate limits
                                 // If FLAG_DOWN:
                                 //   Decrement selected value
                                 //   Validate limits
                                 // If FLAG_CONFIRM:
                                 //   ACTION++
                                 //   If ACTION==4 → exit edit mode
000142 9508                          RET
000143 9508                      RET
                                 
                                 /*=========================================================
                                 =                ALARM MANAGER                           =*/
                                 ALARM_MANAGER:
000144 930f                          PUSH R16
000145 931f                          PUSH R17
                                 
                                 // ---- Compare HOURS ----
000146 9100 0106                     LDS R16, COUNT_HOUR
000148 9110 010a                     LDS R17, ALARM_HOUR
00014a 1701                          CP  R16, R17
00014b f489                          BRNE ALARM_OFF
                                 
                                 // ---- Compare MINUTES ----
00014c 9100 0105                     LDS R16, COUNT_MIN
00014e 9110 0109                     LDS R17, ALARM_MIN
000150 1701                          CP  R16, R17
000151 f459                          BRNE ALARM_OFF
                                 
                                 // ---- MATCH → ACTIVATE ALARM ----
                                 ALARM_ON:
000152 e001                          LDI R16, 1
000153 9300 0114                     STS ALARM_ACTIVE, R16
                                 
                                 // ---- Output on PB4 ----
000155 9100 0112                     LDS R16, BLINK_FLAG
000157 3000                          CPI R16, 0
000158 f011                          BREQ ALARM_LOW
                                 
000159 9a2c                          SBI PORTB, PB4
00015a c006                          RJMP ALARM_EXIT
                                 
                                 ALARM_LOW:
00015b 982c                          CBI PORTB, PB4
00015c c004                          RJMP ALARM_EXIT
                                 
                                 // ---- NO MATCH ----
                                 ALARM_OFF:
00015d 2700                          CLR R16
00015e 9300 0114                     STS ALARM_ACTIVE, R16
000160 982c                          CBI PORTB, PB4
                                 
                                 ALARM_EXIT:
000161 911f                          POP R17
000162 910f                          POP R16
000163 9508                          RET
                                 
                                 /*=========================================================
                                 =                DATE MANAGER                           =*/
                                 DATE_INCREMENT:
000164 930f                          PUSH R16
000165 931f                          PUSH R17
000166 93ef                          PUSH ZL
000167 93ff                          PUSH ZH
                                 
                                 // Incremento de día de manera automatica.
000168 9100 0107                     LDS R16, DAY
00016a 9503                          INC R16
                                 
                                 // Llamado de tabla donde se encuentran los días máximos de cada mes.
00016b 9110 0108                     LDS R17, MONTH
00016d 951a                          DEC R17                 // index = MONTH - 1
                                 
00016e e0f4                          LDI ZH, HIGH(MONTH_MAX_DAY<<1)
00016f e4e2                          LDI ZL, LOW(MONTH_MAX_DAY<<1)
                                 
000170 0fe1                          ADD ZL, R17
000171 2711                          CLR R17
000172 1ff1                          ADC ZH, R17
                                 
000173 9114                          LPM R17, Z              // R17 = max day
                                 
000174 1701                          CP R16, R17
000175 f060                          BRLO STORE_DAY          // if DAY < MAX → store
                                 
                                 // Overflow de día
000176 e001                          LDI R16, 1
000177 9300 0107                     STS DAY, R16
                                 
                                 // Incremento AUTOMATICO de mes
000179 9100 0108                     LDS R16, MONTH
00017b 9503                          INC R16
00017c 300d                          CPI R16, 13
00017d f008                          BRLO STORE_MONTH
                                 
                                 // Overflow de Meses para evitar que pase de 12
00017e e001                          LDI R16, 1
                                 
                                 STORE_MONTH:
00017f 9300 0108                     STS MONTH, R16
000181 c002                          RJMP DATE_EXIT
                                 
                                 STORE_DAY:
000182 9300 0107                     STS DAY, R16
                                 
                                 DATE_EXIT:
000184 91ff                          POP ZH
000185 91ef                          POP ZL
000186 911f                          POP R17
000187 910f                          POP R16
000188 9508                          RET
                                 
                                 //			     INTERRUPT ROUTINES                      //
                                 /*=========================================================
                                 =                TIMER0 ISR                              =*/
                                 TIMER0_ISR:
000189 930f                          PUSH R16
00018a b70f                          IN R16, SREG
00018b 930f                          PUSH R16
                                 
                                     // Logica para Multiplex de un tick cada 10ms.
00018c 9100 010c                     LDS R16, TICKS_10MS
00018e 9503                          INC R16
00018f 9300 010c                     STS TICKS_10MS, R16
                                 
000191 9100 010b                     LDS R16, MUX_SEL
000193 9503                          INC R16
000194 3004                          CPI R16, 4
000195 f008                          BRLO STORE_MUX
000196 2700                          CLR R16
                                 
                                 STORE_MUX:
000197 9300 010b                     STS MUX_SEL, R16
                                 
000199 910f                          POP R16
00019a bf0f                          OUT SREG, R16
00019b 910f                          POP R16
00019c 9518                          RETI
                                 
                                 /*=========================================================
                                 =                TIMER1 ISR                              =*/
                                 TIMER1_ISR:
00019d 930f                          PUSH R16
00019e 931f                          PUSH R17
00019f b70f                          IN   R16, SREG
0001a0 930f                          PUSH R16
                                 
                                 // Cuando se esta en un modo impar (edicion) manda señal para titilar de manera visible.
0001a1 9100 0112                     LDS R16, BLINK_FLAG
0001a3 e011                          LDI R17, 1
0001a4 2701                          EOR R16, R17
0001a5 9300 0112                     STS BLINK_FLAG, R16
                                 
                                 // Logica de guardado de segundo habilitado por el Timer1
0001a7 9100 0116                     LDS R16, HALFSEC_CNT
0001a9 9503                          INC R16
0001aa 3004                          CPI R16, 4
0001ab f130                          BRLO T1_STORE_HALF // Cuenta la cantidad de interrupciones que tiene (hace una interrupcion cada 0.25ms)
                                 
0001ac 2700                          CLR R16
0001ad 9300 0116                     STS HALFSEC_CNT, R16 // Cuenta los medios segundos
                                 
0001af 9100 0117                     LDS R16, SEC_CNT // Cuenta los segundos completos.
0001b1 9503                          INC R16
0001b2 330c                          CPI R16, 60
0001b3 f0d8                          BRLO T1_STORE_SEC
                                 
                                 // Incremento AUTOMATICO de minuto
0001b4 2700                          CLR R16
0001b5 9300 0117                     STS SEC_CNT, R16
                                 
0001b7 9100 0105                     LDS R16, COUNT_MIN
0001b9 9503                          INC R16
0001ba 330c                          CPI R16, 60
0001bb f080                          BRLO T1_STORE_MIN
                                 
                                 // incremento AUTOMTICO de hora
0001bc 2700                          CLR R16
0001bd 9300 0105                     STS COUNT_MIN, R16
                                 
0001bf 9100 0106                     LDS R16, COUNT_HOUR
0001c1 9503                          INC R16
0001c2 3108                          CPI R16, 24
0001c3 f028                          BRLO T1_STORE_HOUR
                                 
                                 // Cambio de Dia (Overflow al pasar de 23h)
0001c4 2700                          CLR R16
0001c5 9300 0106                     STS COUNT_HOUR, R16
                                 
0001c7 df9c                          RCALL DATE_INCREMENT
0001c8 c00b                          RJMP EXIT_T1
                                 
                                 T1_STORE_HOUR:
0001c9 9300 0106                     STS COUNT_HOUR, R16
0001cb c008                          RJMP EXIT_T1
                                 
                                 T1_STORE_MIN:
0001cc 9300 0105                     STS COUNT_MIN, R16
0001ce c005                          RJMP EXIT_T1
                                 
                                 T1_STORE_SEC:
0001cf 9300 0117                     STS SEC_CNT, R16
0001d1 c002                          RJMP EXIT_T1
                                 
                                 T1_STORE_HALF:
0001d2 9300 0116                     STS HALFSEC_CNT, R16
                                 
                                 EXIT_T1:
0001d4 910f                          POP R16
0001d5 bf0f                          OUT SREG, R16
0001d6 911f                          POP R17
0001d7 910f                          POP R16
0001d8 9518                          RETI
                                 
                                 /*=========================================================
                                 =                PIN CHANGE ISR                          =*/
                                 PCINT_ISR:
                                     // Practicas generales de ISR.
0001d9 9a2d                         sbi portb, pb5
0001da 930f                          PUSH R16
0001db 931f                          PUSH R17
0001dc b70f                          IN   R16, SREG
0001dd 930f                          PUSH R16
                                 
                                     // Lee los inputs
0001de b106                          IN   R16, PINC
0001df 700f                          ANDI R16, 0x0F      // Ignora PC4-PC5
                                 
                                     // Loica Inversa de PullUp, si detecta 0 entonces marca.
0001e0 9500                          COM  R16
0001e1 700f                          ANDI R16, 0x0F
                                 
                                     // PC0 → FLAG_UP
0001e2 ff00                          SBRS R16, 0
0001e3 c004                          RJMP CHECK_PC1
0001e4 e011                          LDI  R17, 1
0001e5 9310 010d                     STS  FLAG_UP, R17
0001e7 c011                          RJMP EXIT_PCINT
                                 
                                 CHECK_PC1:
                                     // PC1 → FLAG_DOWN
0001e8 ff01                          SBRS R16, 1
0001e9 c004                          RJMP CHECK_PC2
0001ea e011                          LDI  R17, 1
0001eb 9310 010e                     STS  FLAG_DOWN, R17
0001ed c00b                          RJMP EXIT_PCINT
                                 
                                 CHECK_PC2:
                                     // PC2 → FLAG_MODE
0001ee ff02                          SBRS R16, 2
0001ef c004                          RJMP CHECK_PC3
0001f0 e011                          LDI  R17, 1
0001f1 9310 010f                     STS  FLAG_MODE, R17
0001f3 c005                          RJMP EXIT_PCINT
                                 
                                 CHECK_PC3:
                                     // PC3 → FLAG_CONFIRM
0001f4 ff03                          SBRS R16, 3
0001f5 c003                          RJMP EXIT_PCINT
0001f6 e011                          LDI  R17, 1
0001f7 9310 0110                     STS  FLAG_CONFIRM, R17
                                 
                                 EXIT_PCINT:
0001f9 910f                          POP  R16
0001fa bf0f                          OUT  SREG, R16
0001fb 911f                          POP  R17
0001fc 910f                          POP  R16
0001fd 9518                          RETI
                                 
                                 /*=========================================================
                                 =                TIMER0 Y TIMER1 SETUP                     =*/
                                 TIMER0_SETUP:
                                     // Configurar CTC con Prescaler de 64 con una comparacion de 62 e interrupciones habilitadas
0001fe e002                          LDI R16, (1 << WGM01)
0001ff bd04                          OUT TCCR0A, R16
                                 
000200 e003                          LDI R16, (1 << CS01) | (1 << CS00)
000201 bd05                          OUT TCCR0B, R16
                                 
000202 e30e                          LDI R16, 62
000203 bd07                          OUT OCR0A, R16
                                 
000204 e002                          LDI R16, (1 << OCIE0A)
000205 9300 006e                     STS TIMSK0, R16
                                 
000207 2700                          CLR R16
000208 bd06                          OUT TCNT0, R16
000209 9508                      RET
                                   // Configura CTC con Prescaler de 1024 con valor de comparacion de 488 e interrupciones habilitadas
                                 TIMER1_SETUP:
00020a e00d                          LDI R16, (1 << WGM12) | (1 << CS12) | (1 << CS10)
00020b 9300 0081                     STS TCCR1B, R16
                                 
00020d ee08                          LDI R16, LOW(488)
00020e 9300 0088                     STS OCR1AL, R16
000210 e001                          LDI R16, HIGH(488)
000211 9300 0089                     STS OCR1AH, R16
                                 
000213 e002                          LDI R16, (1 << OCIE1A)
000214 9300 006f                     STS TIMSK1, R16
                                 
000216 2700                          CLR R16
000217 9300 0085                     STS TCNT1H, R16
000219 9300 0084                     STS TCNT1L, R16
                                 
00021b 9508                      RET
                                 /*=========================================================
                                 =                PROGRAM MEMORY TABLES                   =*/
                                 
                                 // ---- Segment table (0–9) ----
                                 SEG_TAB:
00021c 307e
00021d 796d
00021e 5b33
00021f 705f
000220 7b7f                      .DB 0x7E,0x30,0x6D,0x79,0x33,0x5B,0x5F,0x70,0x7F,0x7B
                                 
                                 // ---- Month Maximum Day Table (index = month-1) ----
                                 // Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec
                                 MONTH_MAX_DAY:
000221 1c1f
000222 1e1f
000223 1e1f
000224 1f1f
000225 1f1e


